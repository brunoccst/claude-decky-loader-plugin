{
  "name": "claude-decky-loader-plugin",
  "version": "0.2.1",
  "description": "Decky Loader plugin to manage Claude Code sessions from Steam Big Picture",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunoccst/claude-decky-loader-plugin.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "claude",
    "claude-code"
  ],
  "author": "brunoccst",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/brunoccst/claude-decky-loader-plugin/issues"
  },
  "homepage": "https://github.com/brunoccst/claude-decky-loader-plugin#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
